# Copy to infrastructure/.env on the server. Never commit the real file.
API_DOMAIN=api.example.org
ACME_EMAIL=admin@example.org

POSTGRES_PASSWORD=generate-a-long-random-value
REDIS_PASSWORD=generate-another-long-random-value

LOG_LEVEL=log
DEFAULT_NICHE=tn-cm
INGEST_ENABLED=true
INGEST_INTERVAL_MINUTES=30

# Initial historical load (IST calendar dates), created once by the worker on first start.
INITIAL_BACKFILL_FROM=2026-05-04
INITIAL_BACKFILL_TO=2026-09-18
GDELT_GKG_CONCURRENCY=2

# Browser origins allowed to call the API (native apps do not need CORS). Comma separated.
CORS_ORIGINS=

# Enables GET /metrics on the internal network with "Authorization: Bearer <token>".
METRICS_TOKEN=generate-a-random-token

RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10

# 0 = keep every accepted article searchable. Lower it if the index outgrows the disk.
OPENSEARCH_RETENTION_DAYS=0
RETENTION_REJECTED_DAYS=30
RETENTION_DUPLICATE_DAYS=60
DISK_WARN_PERCENT=80
DISK_CRITICAL_PERCENT=90
