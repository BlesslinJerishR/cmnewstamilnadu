# Copy to .env.development for local runs (values below match infrastructure/docker-compose.dev.yml).
NODE_ENV=development
LOG_LEVEL=log
PORT=3000
DATABASE_URL=postgres://cmnews:cmnews-dev-password@127.0.0.1:55432/cmnews
REDIS_URL=redis://127.0.0.1:56379
OPENSEARCH_URL=http://127.0.0.1:59200
DEFAULT_NICHE=tn-cm
INGEST_ENABLED=true
INGEST_INTERVAL_MINUTES=30
# Initial historical load, created once by the worker on first start (dates in IST).
INITIAL_BACKFILL_FROM=2026-05-04
INITIAL_BACKFILL_TO=2026-09-18
METRICS_TOKEN=change-me-dev-metrics-token
DISK_PATH=/
